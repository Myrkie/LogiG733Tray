<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishAot>true</PublishAot>
        <!-- Shut up the compiler -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
        <PublishTrimmed>true</PublishTrimmed>
        <Authors>Myrkur</Authors>
        <Version>1.2.3</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableRuntimeMarshalling>true</EnableRuntimeMarshalling>
        <PublishIISAssets>false</PublishIISAssets>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>LogiG733Tray-X64Rls</AssemblyName>
        <DebuggerSupport>false</DebuggerSupport>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>LogiG733Tray-X64Dbg</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="HidSharp" Version="2.6.4" />
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
      <PackageReference Include="Serilog" Version="4.3.1" />
      <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="PublishAotCompressed" Version="1.0.5" />
    </ItemGroup>

    <Target Name="DeleteANCIPAfterPublish" AfterTargets="Publish">
        <Message Text="Deleting $(PublishDir)aspnetcorev2_inprocess.dll" Importance="normal" />
        <Delete Files="$(PublishDir)aspnetcorev2_inprocess.dll" ContinueOnError="true" />
    </Target>

    <ItemGroup>
        <EmbeddedResource Include="API\Embedded\Pages\404\unauthorized.html" LogicalName="Pages.Unauthorized.html"/>
        <EmbeddedResource Include="API\Embedded\Pages\404\unauthorized.css" LogicalName="Pages.Unauthorized.css"/>
        <EmbeddedResource Include="API\Embedded\Pages\404\unauthorized.js" LogicalName="Pages.Unauthorized.js"/>
    </ItemGroup>

</Project>
